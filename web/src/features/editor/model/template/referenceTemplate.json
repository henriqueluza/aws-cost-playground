{
  "schemaVersion": 1,
  "region": "us-east-1",
  "workload": {
    "description": "Aplicação web em produção com pouco tráfego, como no começo de um projeto: cerca de 1.000 usuários ativos por mês e 1 milhão de requisições. O Route 53 e o CloudFront servem o site e os arquivos do S3, e o WAF e o ALB protegem e distribuem as chamadas para os contêineres do ECS, que rodam numa instância EC2 t3.small. A aplicação grava no RDS PostgreSQL (20 GB, uma zona) e usa um cache ElastiCache; tarefas assíncronas passam pela fila SQS e pelo Lambda, que grava no DynamoDB. Os blocos usam a carga padrão do contrato; cada ligação de dados e de logs leva 10 GB por mês, exceto os logs de auditoria, permissões e entrega, que são pequenos (1 GB). Troque a descrição pela da sua carga e use Re-estimar carga para ajustar os números."
  },
  "blocks": [
    {
      "id": "blk_route53",
      "type": "aws.route53",
      "label": "DNS",
      "attributes": {},
      "usage": { "source": "default", "values": { "hostedZones": 1, "queriesPerMonth": 1000000 } },
      "overrides": {}
    },
    {
      "id": "blk_cdn",
      "type": "aws.cloudfront",
      "label": "CDN",
      "attributes": {},
      "usage": { "source": "default", "values": { "requestsPerMonth": 1000000 } },
      "overrides": {}
    },
    {
      "id": "blk_waf",
      "type": "aws.waf",
      "label": "Firewall de aplicação",
      "attributes": {},
      "usage": {
        "source": "default",
        "values": { "webAcls": 1, "rules": 5, "requestsPerMonth": 1000000 }
      },
      "overrides": {}
    },
    {
      "id": "blk_assets",
      "type": "aws.s3",
      "label": "Arquivos estáticos",
      "attributes": { "storageClass": "STANDARD" },
      "usage": {
        "source": "default",
        "values": { "storageGb": 50, "putRequestsPerMonth": 100000, "getRequestsPerMonth": 1000000 }
      },
      "overrides": {}
    },
    {
      "id": "blk_alb",
      "type": "aws.alb",
      "label": "Balanceador",
      "attributes": {},
      "usage": {
        "source": "default",
        "values": {
          "newConnectionsPerSecond": 10,
          "activeConnectionsPerMinute": 1000,
          "processedGbPerMonth": 100,
          "ruleEvaluationsPerSecond": 0
        }
      },
      "overrides": {}
    },
    {
      "id": "blk_ecs",
      "type": "aws.ecs",
      "label": "Contêineres da aplicação",
      "attributes": { "az": "a" },
      "usage": { "source": "default", "values": {} },
      "overrides": {}
    },
    {
      "id": "blk_ec2",
      "type": "aws.ec2",
      "label": "Servidor dos contêineres",
      "attributes": { "instanceType": "t3.small", "az": "a" },
      "usage": {
        "source": "default",
        "values": { "instanceCount": 1, "hoursPerMonth": 730, "rootVolumeGb": 30 }
      },
      "overrides": {}
    },
    {
      "id": "blk_lambda",
      "type": "aws.lambda",
      "label": "Tarefas assíncronas",
      "attributes": { "architecture": "arm64", "memoryMb": 512 },
      "usage": {
        "source": "default",
        "values": { "requestsPerMonth": 1000000, "avgDurationMs": 120 }
      },
      "overrides": {}
    },
    {
      "id": "blk_db",
      "type": "aws.rds",
      "label": "Banco relacional",
      "attributes": {
        "engine": "postgres",
        "instanceClass": "db.t3.micro",
        "deployment": "single-az",
        "az": "a"
      },
      "usage": { "source": "default", "values": { "storageGb": 20, "backupStorageGb": 0 } },
      "overrides": {}
    },
    {
      "id": "blk_cache",
      "type": "aws.elasticache",
      "label": "Cache",
      "attributes": { "engine": "redis", "nodeType": "cache.t3.micro", "az": "a" },
      "usage": { "source": "default", "values": { "nodeCount": 1 } },
      "overrides": {}
    },
    {
      "id": "blk_table",
      "type": "aws.dynamodb",
      "label": "Tabela de eventos",
      "attributes": { "capacityMode": "on-demand" },
      "usage": {
        "source": "default",
        "values": {
          "readRequestsPerMonth": 1000000,
          "writeRequestsPerMonth": 500000,
          "storageGb": 5,
          "provisionedReadUnits": 5,
          "provisionedWriteUnits": 5
        }
      },
      "overrides": {}
    },
    {
      "id": "blk_queue",
      "type": "aws.sqs",
      "label": "Fila de tarefas",
      "attributes": { "queueType": "standard" },
      "usage": { "source": "default", "values": { "requestsPerMonth": 1000000 } },
      "overrides": {}
    },
    {
      "id": "blk_secrets",
      "type": "aws.secrets-manager",
      "label": "Segredos",
      "attributes": {},
      "usage": { "source": "default", "values": { "secrets": 5, "apiCallsPerMonth": 100000 } },
      "overrides": {}
    },
    {
      "id": "blk_auth",
      "type": "aws.cognito",
      "label": "Login de usuários",
      "attributes": { "tier": "essentials" },
      "usage": { "source": "default", "values": { "monthlyActiveUsers": 1000 } },
      "overrides": {}
    },
    {
      "id": "blk_nat",
      "type": "aws.nat-gateway",
      "label": "Saída para a internet",
      "attributes": {},
      "usage": { "source": "default", "values": { "processedGbPerMonth": 100 } },
      "overrides": {}
    },
    {
      "id": "blk_logs",
      "type": "aws.cloudwatch",
      "label": "Logs e métricas",
      "attributes": {},
      "usage": {
        "source": "default",
        "values": {
          "logsIngestedGbPerMonth": 5,
          "logsStoredGb": 5,
          "customMetrics": 10,
          "alarms": 10
        }
      },
      "overrides": {}
    },
    {
      "id": "blk_trail",
      "type": "aws.cloudtrail",
      "label": "Auditoria",
      "attributes": {},
      "usage": {
        "source": "default",
        "values": { "trails": 1, "managementEventsPerMonth": 100000, "dataEventsPerMonth": 0 }
      },
      "overrides": {}
    },
    {
      "id": "blk_pipeline",
      "type": "aws.codepipeline",
      "label": "Entrega contínua",
      "attributes": { "pipelineType": "V2" },
      "usage": {
        "source": "default",
        "values": { "activePipelines": 1, "executionMinutesPerMonth": 500 }
      },
      "overrides": {}
    },
    {
      "id": "blk_stack",
      "type": "aws.cloudformation",
      "label": "Infra como código",
      "attributes": {},
      "usage": { "source": "default", "values": {} },
      "overrides": {}
    },
    {
      "id": "blk_iam",
      "type": "aws.iam",
      "label": "Permissões",
      "attributes": {},
      "usage": { "source": "default", "values": {} },
      "overrides": {}
    }
  ],
